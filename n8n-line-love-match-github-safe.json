    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst events = (payload.body || payload).events || [];\nconst event = events.find(e => e.type === 'message' && e.message?.type === 'text');\nif (!event || !event.replyToken || !event.source?.userId) return [];\n\nconst text = String(event.message.text || '').trim();\nconst basic = { lineUserId: event.source.userId, replyToken: event.replyToken };\nconst help = '💘 我是阿澤戀愛配對精靈！\\n報名請傳：\\n同意報名|暱稱|年齡|城市|興趣1,興趣2\\n\\n範例：同意報名|阿澤|21|新竹|拉麵,攝影,電影\\n\\n報名後傳「開始配對」就能找共同興趣的學員。限18歲以上，請勿填電話、住址或真實姓名。';\n\nif (text === '開始配對') return [{ json: { ...basic, action: 'match' } }];\nif (/^破冰[|｜]/.test(text)) {\n  const topic = text.split(/[|｜]/).slice(1).join(' ').trim().slice(0, 200);\n  if (!topic) return [{ json: { ...basic, action: 'help', responseText: help } }];\n  return [{ json: { ...basic, action: 'ai', prompt: '請用繁體中文，根據這個聊天情境給一句自然、不油膩的交友破冰開場白及簡短理由，80字內：' + topic } }];\n}\nconst pieces = text.split(/[|｜]/).map(v => v.trim());\nif (pieces[0] === '同意報名') {\n  const age = Number(pieces[2]);\n  const okay = pieces.length === 5 && pieces[1]?.length > 0 && pieces[1].length <= 20 &&\n    Number.isInteger(age) && age >= 18 && age <= 120 && pieces[3]?.length > 0 &&\n    pieces[3].length <= 20 && pieces[4]?.length > 0 && pieces[4].length <= 100;\n  if (!okay) return [{ json: { ...basic, action: 'help', responseText: '報名格式有誤，或年齡未滿18歲。\\n\\n' + help } }];\n  return [{ json: {\n    ...basic, action: 'register', nickname: pieces[1], age,\n    city: pieces[3], interests: pieces[4], optIn: true,\n  } }];\n}\nreturn [{ json: { ...basic, action: 'help', responseText: help } }];"
      },
