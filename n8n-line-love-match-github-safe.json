    {
      "parameters": {
        "jsCode": "const requester = $('LINE 解析指令').first().json;\nconst rows = $input.all().map(i => i.json).filter(row => row && row.lineUserId);\nconst agreed = value => value === true || value === 1 || String(value).toLowerCase() === 'true';\nconst me = rows.find(p => p.lineUserId === requester.lineUserId && agreed(p.optIn));\nif (!me) {\n  return [{ json: { canMatch: false, responseText: '你還沒完成報名喔！\\n請傳：同意報名|暱稱|年齡|城市|興趣1,興趣2' } }];\n}\nconst split = (value) => [...new Set(String(value || '').split(/[,，、]/).map(s => s.trim().toLowerCase()).filter(Boolean))];\nconst a = split(me.interests);\nconst candidates = rows.filter(p => p.lineUserId !== me.lineUserId && agreed(p.optIn) && Number(p.age) >= 18);\nif (!candidates.length) {\n  return [{ json: { canMatch: false, responseText: '目前還沒有其他完成報名的學員，先邀請朋友加入吧 💘' } }];\n}\nconst scored = candidates.map(other => {\n  const b = split(other.interests);\n  const shared = a.filter(s => b.includes(s));\n  const union = new Set([...a, ...b]).size;\n  const sharedScore = union ? 70 * shared.length / union : 0;\n  const cityBonus = String(me.city).trim() === String(other.city).trim() ? 15 : 0;\n  const ageGap = Math.abs(Number(me.age) - Number(other.age));\n  const ageBonus = 15 * (1 - Math.min(ageGap, 10) / 10);\n  const score = Math.round(Math.min(100, sharedScore + cityBonus + ageBonus));\n  return { other, shared, ageGap, score };\n}).sort((x, y) => y.score - x.score);\nconst best = scored[0];\nif (best.score < 60) {\n  return [{ json: { canMatch: false, responseText: '目前還沒有達到60分的興趣配對對象，等等再來看看！\\n這個分數只代表興趣、城市與年齡相似度，不是戀愛成功率。' } }];\n}\nconst prompt = [\n  '用自然、親切、簡短的繁體中文介紹以下興趣配對。不要誇大成戀愛成功率，也不要表示雙方已經認識。',\n  '配對方式：共同興趣 70 分、同城市 15 分、年齡接近 15 分；60 分以上推薦。',\n  '只介紹暱稱與公開報名的興趣，不提供 LINE ID、聯絡方式或精確個資。',\n  '發問者暱稱：' + String(me.nickname),\n  '候選人暱稱：' + String(best.other.nickname),\n  '共同興趣：' + (best.shared.join('、') || '尚無'),\n  '城市是否相同：' + (me.city === best.other.city ? '是' : '否'),\n  '年齡差：' + best.ageGap,\n  '相似度分數：' + best.score,\n  '最後用一句話建議怎麼破冰，回覆在150字以內。',\n].join('\\n');\nreturn [{ json: { canMatch: true, prompt, score: best.score } }];"
      },
