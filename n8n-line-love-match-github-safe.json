    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst split = (text) => [...new Set(String(text || '').split(/[,，、]/).map(x => x.trim().toLowerCase()).filter(Boolean))];\nconst a = split(data.interestsA), b = split(data.interestsB);\nconst shared = a.filter(x => b.includes(x));\nconst union = new Set([...a, ...b]).size;\nconst sharedScore = union ? 70 * shared.length / union : 0;\nconst cityBonus = data.cityA === data.cityB ? 15 : 0;\nconst ageGap = Math.abs(Number(data.ageA) - Number(data.ageB));\nconst ageBonus = 15 * (1 - Math.min(ageGap, 10) / 10);\nconst score = Math.round(Math.min(100, sharedScore + cityBonus + ageBonus));\nconst result = score >= 60 ? 'YES' : 'NO';\nreturn [{ json: { ...data, sharedInterests: shared, ageGap, score, result, explanation: '分數只根據共同興趣、城市與年齡差計算，並非真正的戀愛成功率。' } }];"
      },
